{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "儿童流感季剂次账领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CHILD_REGISTERED",
        "POLICY_PUBLISHED",
        "CONSENT_RECORDED",
        "DEFERRAL_RECORDED",
        "DOSE_RECORDED",
        "RECORD_MATCHED",
        "DOSE_RECONCILED",
        "PLAN_CREATED",
        "BATCH_SUSPENDED",
        "PROOF_ISSUED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "season_policy",
        "child_record",
        "dose_event",
        "dose_plan",
        "batch_notice"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "CHILD_REGISTERED": [
      "birth_date",
      "home_region"
    ],
    "POLICY_PUBLISHED": [
      "guideline_version",
      "season_start",
      "season_end",
      "advisory_complete_by"
    ],
    "CONSENT_RECORDED": [
      "scope",
      "granted"
    ],
    "DEFERRAL_RECORDED": [
      "season_id",
      "reason_kind"
    ],
    "DOSE_RECORDED": [
      "child_ref",
      "season_id",
      "dose_seq",
      "administered_at",
      "lot_no",
      "origin",
      "executor_id"
    ],
    "RECORD_MATCHED": [
      "external_ref",
      "source_region",
      "match_auth_id"
    ],
    "DOSE_RECONCILED": [
      "season_id",
      "dose_seq",
      "kept_event_id"
    ],
    "PLAN_CREATED": [
      "child_id",
      "season_id",
      "lot_no",
      "planned_for"
    ],
    "BATCH_SUSPENDED": [
      "lot_no",
      "effective_at"
    ],
    "PROOF_ISSUED": [
      "viewer_role",
      "record_version"
    ]
  },
  "additionalProperties": false
}
